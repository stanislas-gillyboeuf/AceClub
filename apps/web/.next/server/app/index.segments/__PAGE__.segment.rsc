16:["$","$L7",null,{"id":"faq","title":"FAQ","subtitle":"Questions fréquentes","className":"container px-10 mx-auto max-w-[var(--max-container-width)]","children":["$","$L23",null,{"type":"single","collapsible":true,"className":"w-full max-w-2xl mx-auto py-10","children":[["$","$L24","0",{"value":"item-0","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"L'application est-elle vraiment gratuite pour les membres ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"Oui, l'application AceClub est 100% gratuite pour tous les membres des clubs partenaires. Téléchargez-la, créez votre compte, et commencez à trouver des partenaires immédiatement. Aucun paiement, aucune publicité."}]}]]}],["$","$L24","1",{"value":"item-1","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"Comment mon club peut-il rejoindre AceClub ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"Contactez-nous via le formulaire de contact ou par email à contact@aceclub.app. Nous vous présenterons les fonctionnalités et établirons un devis personnalisé selon la taille de votre club."}]}]]}],["$","$L24","2",{"value":"item-2","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"Quels sports sont supportés ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"AceClub est conçu principalement pour le tennis et le padel. Nous travaillons à étendre notre offre à d'autres sports de raquette comme le squash et le badminton."}]}]]}],["$","$L24","3",{"value":"item-3","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"Mes données sont-elles sécurisées ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"AceClub respecte le RGPD et toutes les réglementations européennes sur la protection des données. Vos informations personnelles sont chiffrées et ne sont jamais partagées avec des tiers sans votre consentement explicite."}]}]]}],["$","$L24","4",{"value":"item-4","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"Comment créer mon profil joueur ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"Après avoir téléchargé l'application, créez votre compte et renseignez votre niveau de jeu, vos disponibilités et vos préférences. Ces informations permettent de vous connecter avec des partenaires compatibles."}]}]]}],["$","$L24","5",{"value":"item-5","children":[["$","$L25",null,{"className":"text-left hover:no-underline","children":"Comment fonctionne le système de défis ?"}],["$","$L26",null,{"children":["$","span",null,{"children":"Les défis sont des challenges sociaux proposés par votre club ou par AceClub. Jouez un certain nombre de matchs, invitez des nouveaux membres, ou participez à des événements pour gagner des Aces et monter dans le classement."}]}]]}]]}]}]
