{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "bun": "1.3.11",
      "ios": {
             "simulator": true
           }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.ace-club.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.ace-club.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758263483"
      }
    }
  }
}
