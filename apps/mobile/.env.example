# ─── API endpoint ──────────────────────────────────────────────────────────
# Local dev: pointer le bundler Metro vers l'API locale (Hono)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Prod (commenter en dev)
#EXPO_PUBLIC_API_URL=https://api.ace-club.app

# ─── Google Sign-In ────────────────────────────────────────────────────────
# Web client ID (utilisé pour Better Auth + Android)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID (reverse-domain, scheme déclaré dans app.json)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ─── Runtime ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_NODE_ENV=development

# ─── EAS ────────────────────────────────────────────────────────────────────
# Project ID Expo (cf. app.json > expo.extra.eas.projectId)
PROJECT_ID=55848fd1-bd32-4e6d-bd4b-d8d2066fcdc6
