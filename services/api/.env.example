# ─── Database ───────────────────────────────────────────────────────────────
# Local dev (docker-compose up -d in services/api/)
DATABASE_URL=postgresql://postgres:postgres@localhost:5558/db

# ─── Better Auth ────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
# URL where Better Auth callbacks land (web app in dev)
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (Sign-In with Google) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple Push Notifications (iOS) ────────────────────────────────────────
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=dev.aceclub.app
# Paste the .p8 contents including BEGIN/END lines, keep the surrounding quotes
APNS_SIGNING_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"

# ─── AI / LLM ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# ─── Email (Resend — club dues reminders, broadcast messages) ─────────────
RESEND_API_KEY=

# ─── Trigger.dev (background jobs) ─────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Object storage (MinIO / S3-compatible) ────────────────────────────────
MINIO_ENDPOINT=
MINIO_PUBLIC_URL=
MINIO_BUCKET_NAME=app
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ─── Redis (chat pub/sub for multi-pod WebSocket) ──────────────────────────
REDIS_PUBLIC_URL=redis://default:password@host:port

# ─── Demo booking (Google Calendar + Meet) ──────────────────────────────────
# Generate with: openssl rand -base64 32
DEMO_BOOKING_ENCRYPTION_KEY=
# Public URL of the public /demo pages (booking confirmation, cancel/reschedule links in emails)
DEMO_BOOKING_PUBLIC_URL=https://ace-club.app
# Dedicated OAuth client for Calendar access (separate from GOOGLE_CLIENT_ID/SECRET above, which
# is only for "Sign in with Google"). Redirect URI to register on this client:
# https://ace-club.app/dashboard/demo-booking/google-callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
